grammar gen.Mdefdllu with org.eclipse.xtext.common.Terminals

import "platform:/resource/pruebaModelo/model/pruebaModelo.ecore"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

RaizFDLLU returns RaizFDLLU:
    'RaizFDLLU' name=ID
    '{'
        (arregloint+=ArregloInt | arreglostring+=ArregloString)*
    '}';

ArregloInt returns ArregloInt:
    'arreglo' name=ID 'int' 
    '[' valores+=EInt (',' valores+=EInt)* ']';

ArregloString returns ArregloString:
    'arreglo' name=ID 'String'
    '[' valores+=EString (',' valores+=EString)* ']';

EString returns ecore::EString:
    STRING | ID;

EInt returns ecore::EInt:
    '-'? INT;